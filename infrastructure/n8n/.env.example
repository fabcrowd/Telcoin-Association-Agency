# Copy this file to .env and fill in real values
# Never commit .env — it is gitignored

# Random string — used to encrypt stored credentials in n8n
# Generate one: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-random-string

# Public URL where Fellow can POST webhook events to n8n
# Local dev: use ngrok — run `ngrok http 5678` and paste the https URL here (trailing slash required)
# Production: your server's public domain (e.g. https://n8n.yourdomain.com/)
N8N_WEBHOOK_URL=https://your-public-url.com/

# Fellow API credentials (entered in n8n GUI — not used by Docker directly)
# Kept here as reference so you know what to have ready
FELLOW_SUBDOMAIN=your-workspace
FELLOW_API_KEY=your-fellow-api-key

# GitHub Personal Access Token with repo scope
# Generate: github.com/settings/tokens → Tokens (classic) → repo scope
# Used in n8n GitHub credential — not used by Docker directly
GITHUB_TOKEN=ghp_your-token-here
